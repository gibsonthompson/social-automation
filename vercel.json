{
  "functions": {
    "src/app/api/generate/route.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/render/route.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/cron/generate/route.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/cron/post/route.js": {
      "maxDuration": 120,
      "memory": 512
    },
    "src/app/api/cron/metrics/route.js": {
      "maxDuration": 120,
      "memory": 512
    },
    "src/app/api/cron/analyze/route.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/generate",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/post",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/metrics",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/analyze",
      "schedule": "0 11 * * 0"
    }
  ]
}